{
  "expo": {
    "name": "ServEasy Provider",
    "slug": "provider-app",
    "version": "1.0.8",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.serveasy.provider",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.serveasy.provider",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ServEasy to use your location to pin exact provider service addresses."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "largeIcon": "./assets/icon.png",
          "color": "#FFD60A",
          "defaultChannel": "pending-bookings",
          "sounds": [
            "./assets/audio/serveasy_booking_ringtone.wav"
          ]
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/fc1a7de7-01d6-47ae-8bd8-66afc8dfade4",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000,
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "runtimeVersion": "1.0.8",
    "extra": {
      "eas": {
        "projectId": "fc1a7de7-01d6-47ae-8bd8-66afc8dfade4"
      }
    },
    "owner": "saikat931"
  }
}
